# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...          # api 전용, 절대 프론트 노출 금지
SUPABASE_JWT_SECRET=super-secret-jwt-token

# ─── apps/web ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUiv...
# OAuth 없이 테스트 계정으로 들어가려면 true. 실제 사용자를 받기 전에 지운다.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# ─── apps/api ────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token
VAPID_PUBLIC_KEY=BEl62iUYgUiv...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:team@lastly.app

# capture 초안 토큰 서명 키. 16자 이상.
DRAFT_TOKEN_SECRET=dev-draft-secret-change-me

# 서버가 제공하는 기본 AI 키. 있으면 사용자는 아무것도 등록하지 않아도 된다.
# Gemini 무료 등급을 쓴다 — aistudio.google.com/apikey 에서 카드 없이 발급된다.
# 비우면 각자 앱에서 자기 키를 등록해야 해석이 동작한다.
GEMINI_API_KEY=

# 위가 비어 있을 때만 쓰는 예전 기본 키.
ANTHROPIC_API_KEY=

# 알림 배치를 서버 안 시계로 돌릴지. 배포 환경에서는 false로 두고
# 밖에서 /v1/internal/dispatch-digests 를 두드린다 (docs/DEPLOY.md 참고).
ENABLE_CRON=true
# 그 엔드포인트를 지키는 공유 비밀. GitHub Actions 시크릿과 같은 값이어야 한다.
CRON_SECRET=dev-cron-secret-please-change

# ─── apps/ai ─────────────────────────────────────────────────
# 제공자별 모델. 비우면 각 어댑터의 기본값을 쓴다.
#   anthropic: claude-opus-5 / openai: gpt-4o-mini / gemini: gemini-2.0-flash
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=
# Anthropic 의 effort(low·medium·high). Haiku 등 지원하지 않는 모델이 있어 기본은 안 보낸다.
ANTHROPIC_EFFORT=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
INTERNAL_TOKEN=dev-internal-token

# ─── apps/ai (선택) ──────────────────────────────────────────
# 의미 기반 항목 매칭을 켜려면 설정. 비우면 트라이그램 매칭만 동작한다.
VOYAGE_API_KEY=
