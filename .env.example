# ─── Supabase ────────────────────────────────────────────────
# Supabase 대시보드 → Settings → API 에서 가져온다. docs/SETUP.md 참고.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                     # api 전용, 절대 프론트 노출 금지

# ─── apps/web ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# npx web-push generate-vapid-keys 로 만든 Public Key. 아래 VAPID_PUBLIC_KEY 와 같은 값.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# OAuth 없이 테스트 계정으로 들어가려면 true. 실제 사용자를 받기 전에 지운다.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# ─── apps/api ────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
# 날짜를 세는 기준 시간대. 서버는 UTC 로 돌기 때문에 이 값이 없으면 새벽 기록이 어제로 저장된다.
APP_TIMEZONE=Asia/Seoul
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@lastly.app

# capture 초안 토큰 서명 키. 16자 이상.
DRAFT_TOKEN_SECRET=dev-draft-secret-change-me

# 새 항목 주기 추천에만 쓴다. 문장 해석은 규칙(+기기 Gemma)이 한다.
# Gemini 무료 등급 — aistudio.google.com/apikey
GEMINI_API_KEY=

# 위가 비어 있을 때만 쓰는 예전 기본 키.
ANTHROPIC_API_KEY=

# 알림 배치를 서버 안 시계로 돌릴지. 배포 환경에서는 false로 두고
# 밖에서 /v1/internal/dispatch-digests 를 두드린다 (docs/DEPLOY.md 참고).
ENABLE_CRON=true
# 그 엔드포인트를 지키는 공유 비밀. GitHub Actions 시크릿과 같은 값이어야 한다.
CRON_SECRET=dev-cron-secret-please-change

# ─── apps/ai ─────────────────────────────────────────────────
# 제공자별 모델. 비우면 각 어댑터의 기본값을 쓴다.
#   gemini: gemini-3.5-flash-lite / anthropic: claude-opus-5
GEMINI_MODEL=
ANTHROPIC_MODEL=
# Anthropic 의 effort(low·medium·high). Haiku 등 지원하지 않는 모델이 있어 기본은 안 보낸다.
ANTHROPIC_EFFORT=
# Gemini 3.x 는 기본으로 생각하고 답해 느리다. 짧은 추출에는 low 로 충분하다.
# 구 모델은 이 값을 400 으로 막으므로 그때는 비운다.
GEMINI_THINKING_LEVEL=low
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
INTERNAL_TOKEN=dev-internal-token

# ─── apps/ai (선택) ──────────────────────────────────────────
# 의미 기반 항목 매칭을 켜려면 설정. 비우면 트라이그램 매칭만 동작한다.
VOYAGE_API_KEY=

# ─── 온디바이스 모델 ─────────────────────────────────────────
# 앱 기본 모델: gemma3-1b(기본) | gemma3-270m | chrome-nano
# chrome-nano 를 못 쓰는 기기(Android 등)는 gemma3-1b 로 대체한다.
NEXT_PUBLIC_ONDEVICE_MODEL=
# 브라우저가 GET 할 Gemma 1B 파일 주소. 비우면 Hugging Face 공개 파일을 쓴다.
NEXT_PUBLIC_ONDEVICE_MODEL_URL=
# Gemma 270M 파일 주소. 비우면 Hugging Face(nuuco) 사본을 쓴다.
NEXT_PUBLIC_ONDEVICE_MODEL_270M_URL=
