# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...          # api 전용, 절대 프론트 노출 금지
SUPABASE_JWT_SECRET=super-secret-jwt-token

# ─── apps/web ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BEl62iUYgUiv...
# OAuth 없이 테스트 계정으로 들어가려면 true. 실제 사용자를 받기 전에 지운다.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=true

# ─── apps/api ────────────────────────────────────────────────
PORT=4000
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token
VAPID_PUBLIC_KEY=BEl62iUYgUiv...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:team@lastly.app

# 사용자가 등록한 AI 키를 암호화하는 비밀값. base64 로 인코딩한 32바이트.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 이 값을 잃으면 저장된 키를 아무도 풀 수 없다. 사용자가 다시 등록해야 한다.
CREDENTIALS_SECRET=

# capture 초안 토큰 서명 키. 16자 이상.
DRAFT_TOKEN_SECRET=dev-draft-secret-change-me

# 무료 체험용 서버 키. 사용자가 자기 키를 등록하기 전 3번까지 이 키로 대신 부른다.
# 비우면 체험 없이 각자 키를 등록해야만 쓸 수 있다.
ANTHROPIC_API_KEY=sk-ant-...

# 알림 배치를 서버 안 시계로 돌릴지. 배포 환경에서는 false로 두고
# 밖에서 /v1/internal/dispatch-digests 를 두드린다 (docs/DEPLOY.md 참고).
ENABLE_CRON=true
# 그 엔드포인트를 지키는 공유 비밀. GitHub Actions 시크릿과 같은 값이어야 한다.
CRON_SECRET=dev-cron-secret-please-change

# ─── apps/ai ─────────────────────────────────────────────────
AI_MODEL=claude-opus-5
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
INTERNAL_TOKEN=dev-internal-token

# ─── apps/ai (선택) ──────────────────────────────────────────
# 의미 기반 항목 매칭을 켜려면 설정. 비우면 트라이그램 매칭만 동작한다.
VOYAGE_API_KEY=
